<Window x:Class="SistemaDeGestão.View.CadastroParticipanteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaDeGestão.View"
        mc:Ignorable="d"
        Title="CadastroParticipanteWindow" Height="600" Width="800">
    <Grid Background="#F2F2F2">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="43"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Name="Moldura"
                                Background="White"
                                BorderBrush="#626262"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Grid Margin="13,0">
                                    <ScrollViewer Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Name="Dica"
                                           Text="Value"
                                           Foreground="#808080"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Dica"
                                        Property="Visibility"
                                        Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Moldura"
                                        Property="BorderBrush"
                                        Value="#10748A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Height" Value="43"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Name="Moldura"
                                Background="White"
                                BorderBrush="#626262"
                                BorderThickness="1"
                                CornerRadius="7">
                                <ScrollViewer Name="PART_ContentHost"
                                          Margin="13,0"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Moldura"
                                        Property="BorderBrush"
                                        Value="#10748A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Name="Fundo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Voltar">
                                    <Setter TargetName="Fundo" Property="CornerRadius" Value="30"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Viewbox Stretch="Uniform">
            <Grid Width="1056" Height="687">
                <Border Width="452"
                    Padding="49,28,49,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="34">
                    <StackPanel>
                        <TextBlock Text="Cadastro do&#10;Participante"
                               Margin="0,0,0,8"
                               FontFamily="Segoe UI"
                               FontSize="28"
                               TextAlignment="Center"/>

                        <TextBlock Text="Nome"/>
                        <TextBox x:Name="NomeCadastroParticipanteTextBox"/>

                        <TextBlock Text="Email"/>
                        <TextBox x:Name="EmailCadastroParticipanteTextBox"/>

                        <TextBlock Text="Número"/>
                        <TextBox x:Name="NumeroCadastroParticipanteTextBox"/>

                        <TextBlock Text="CPF"/>
                        <TextBox x:Name="CpfCadastroParticipanteTextBox"/>

                        <TextBlock Text="Criar senha"/>
                        <PasswordBox x:Name="SenhaCadastroParticipantePasswordBox"/>

                        <TextBlock Text="Confirmar senha"/>
                        <PasswordBox x:Name="ConfirmarSenhaCadastroParticipantePasswordBox"/>

                        <Button x:Name="EnviarCadastroParticipanteButton"
                            Content="Enviar"
                            Width="187"
                            Height="49"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Background="#10748A"
                            Foreground="White"
                            BorderBrush="#15343A"
                            BorderThickness="1"
                            FontSize="14"/>
                    </StackPanel>
                </Border>

                <Button x:Name="VoltarButton"
                    Tag="Voltar"
                    Content="Clique aqui p/ voltar"
                    Width="154"
                    Height="58"
                    Margin="0,18,28,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="White"
                    Foreground="Black"
                    BorderThickness="0"
                    FontFamily="Georgia"
                    FontWeight="Bold"
                    FontSize="14">
                    <Button.Effect>
                        <DropShadowEffect Color="Black"
                                      Direction="270"
                                      ShadowDepth="4"
                                      BlurRadius="4"
                                      Opacity="0.65"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
