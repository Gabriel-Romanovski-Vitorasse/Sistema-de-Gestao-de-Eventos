<Window x:Class="SistemaDeGestão.View.CadastroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaDeGestão.View"
        mc:Ignorable="d"
        Title="CadastroWindow" Height="800" Width="800">
    <Grid>

        <Button Content="Clique aqui p/ voltar"
            Width="135"
            Height="50"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,25,0"
            Background="White"
            Foreground="Black"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"/>

        <Border Width="390"
            Height="525"
            Background="White"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="40">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Cadastro"
                       FontSize="34"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Grid.Row="0"/>

                <TextBlock Text="Para cadastrar como organizador (pessoa física), registre aqui:"
                       Grid.Row="2"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

                <Button x:Name="FazerCadastroOrgPFButton" Content="Clique aqui para fazer o cadastro"
                    Grid.Row="3"
                    Width="280"
                    Height="45"
                    HorizontalAlignment="Center"
                    Background="#4CAF50"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

                <TextBlock Text="Para cadastrar como organizador (pessoa jurídica), registre aqui:"
                       Grid.Row="4"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

                <Button x:Name="FazerCadastroOrgPJButton" Content="Clique aqui para fazer o cadastro"
                    Grid.Row="5"
                    Width="280"
                    Height="45"
                    HorizontalAlignment="Center"
                    Background="#4CAF50"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

                <TextBlock Text="Para cadastrar como participante, registre aqui:"
                       Grid.Row="6"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

                <Button x:Name="FazerCadastroParticipanteButton" Content="Clique aqui para fazer o cadastro"
                    Grid.Row="8"
                    Width="280"
                    Height="45"
                    HorizontalAlignment="Center"
                    Background="#4CAF50"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            </Grid>
        </Border>
    </Grid>
</Window>
