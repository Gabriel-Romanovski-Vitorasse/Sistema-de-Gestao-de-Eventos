<Window x:Class="SistemaDeGestão.View.CadastroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaDeGestão.View"
        mc:Ignorable="d"
        Title="CadastroWindow" Height="600" Width="800">
    <Grid Background="#F2F2F2">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="326"/>
                <Setter Property="Height" Value="51"/>
                <Setter Property="Background" Value="#155F75"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="Georgia"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17">
                                <Border.Effect>
                                    <DropShadowEffect Direction="285"
                                                  ShadowDepth="5"
                                                  BlurRadius="4"
                                                  Opacity="0.30"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Voltar">
                                    <Setter TargetName="Fundo" Property="CornerRadius" Value="30"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Viewbox Stretch="Uniform">
            <Grid Width="1046" Height="683">
                <Border Width="452"
                    Height="609"
                    Margin="8,45,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="34">
                    <Border.Effect>
                        <DropShadowEffect Direction="270"
                                      ShadowDepth="4"
                                      BlurRadius="4"
                                      Opacity="0.45"/>
                    </Border.Effect>

                    <Grid Margin="42,22,42,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="143"/>
                            <RowDefinition Height="143"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                               Text="Aba&#10;Cadastro"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               TextAlignment="Center"
                               FontSize="40"
                               FontFamily="Segoe UI"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Para cadastrar como organizador (pessoa física), registre aqui:"
                                   Margin="6,0,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                            <Button x:Name="FazerCadastroOrgPFButton"
                                Content="Clique aqui para fazer o cadastro"
                                AutomationProperties.Name="Cadastrar organizador pessoa física"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Para cadastrar como organizador (pessoa jurídica), registre aqui:"
                                   Margin="6,0,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                            <Button x:Name="FazerCadastroOrgPJButton"
                                Content="Clique aqui para fazer o cadastro"
                                AutomationProperties.Name="Cadastrar organizador pessoa jurídica"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Para cadastrar como participante, registre aqui:"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                            <Button x:Name="FazerCadastroParticipanteButton"
                                Content="Clique aqui para fazer o cadastro"
                                AutomationProperties.Name="Cadastrar participante"
                                Margin="6,9,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Name="btnVoltar"
                    Tag="Voltar"
                    Content="Clique aqui p/ voltar"
                    Width="154"
                    Height="58"
                    Margin="0,16,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="White"
                    Foreground="Black"
                    FontSize="14"/>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
