<Window x:Class="SistemaDeGestão.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaDeGestão.View"
        mc:Ignorable="d"
        Title="LoginWindow" Height="600" Width="800">
<Grid Background="#F2F2F2">
    <Grid.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Fundo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Cadastro">
                                <Setter TargetName="Fundo"
                                        Property="CornerRadius"
                                        Value="14"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="838" Height="556">
            <Border Width="363"
                    Height="490"
                    Margin="0,37,0,0"
                    Padding="39,17,39,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="28">

                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      Direction="270"
                                      ShadowDepth="3"
                                      BlurRadius="3"
                                      Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Login"
                               FontFamily="Segoe UI"
                               FontSize="32"
                               TextAlignment="Center"/>

                    <TextBlock Text="Email"
                               Margin="0,38,0,5"
                               FontSize="11"/>

                    <Border Height="35"
                            Background="White"
                            BorderBrush="#808080"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <TextBox x:Name="EmailLoginTextBox"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"/>

                            <TextBlock Text="Value"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       Foreground="#808080"
                                       FontSize="11"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtEmail}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="Senha"
                               Margin="0,27,0,5"
                               FontSize="11"/>

                    <Border Height="35"
                            Background="White"
                            BorderBrush="#808080"
                            BorderThickness="1"
                            CornerRadius="5">
                        <PasswordBox x:Name="SenhaLoginPasswordBox"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"/>
                    </Border>

                    <Button x:Name="ConfirmarLoginButton"
                            Content="Confirmar"
                            Width="150"
                            Height="39"
                            Margin="0,36,0,0"
                            HorizontalAlignment="Center"
                            Background="#10748A"
                            BorderBrush="#15343A"
                            BorderThickness="1"
                            FontSize="11"
                            IsDefault="True"/>

                    <TextBlock Text="Caso não tenha efetuado o cadastro, clique no botão abaixo:"
                               Margin="0,34,0,0"
                               TextWrapping="Wrap"
                               FontSize="11"/>

                    <Button x:Name="AcessarCadastroButton"
                            Tag="Cadastro"
                            Content="Clique aqui p/ acessar a aba cadastro"
                            Width="262"
                            Height="41"
                            Margin="0,27,0,0"
                            HorizontalAlignment="Center"
                            Background="#145F75"
                            BorderThickness="0"
                            FontFamily="Georgia"
                            FontSize="11"
                            FontWeight="Bold">
                        <Button.Effect>
                            <DropShadowEffect Color="Black"
                                              Direction="315"
                                              ShadowDepth="3"
                                              BlurRadius="3"
                                              Opacity="0.4"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Grid>
</Window>
