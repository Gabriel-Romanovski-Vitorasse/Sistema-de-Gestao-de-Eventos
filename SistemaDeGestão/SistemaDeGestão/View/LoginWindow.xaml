<Window x:Class="SistemaDeGestão.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaDeGestão.View"
        mc:Ignorable="d"
        Title="LoginWindow" Height="800" Width="800">
    <Grid>

        <Border Width="430"
            Height="575"
            Background="White"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="45">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Login"
                       FontSize="36"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Grid.Row="0"/>

                <TextBlock Text="Email"
                       FontSize="13"
                       Grid.Row="2"
                       VerticalAlignment="Top"/>

                <TextBox x:Name="emailTextBox" Grid.Row="2"
                     Height="40"
                     Margin="0,20,0,0"
                     VerticalAlignment="Top"
                     FontSize="14"
                     Padding="10"/>

                <TextBlock Text="Senha"
                       FontSize="13"
                       Grid.Row="4"
                       VerticalAlignment="Top"/>

                <PasswordBox x:Name="SenhaPasswordBox" Grid.Row="4"
                         Height="40"
                         Margin="0,20,0,0"
                         VerticalAlignment="Top"
                         FontSize="14"
                         Padding="10"/>

                <Button x:Name="ConfirmarButton" Content="Confirmar"
                    Grid.Row="6"
                    Width="175"
                    Height="45"
                    HorizontalAlignment="Center"
                    Background="#219653"
                    Foreground="White"
                    BorderBrush="Black"
                    Cursor="Hand"/>

                <TextBlock Text="Caso não tenha efetuado o cadastro, clique no botão abaixo:"
                       Grid.Row="8"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

                <Button x:Name="AcessarCadastroButton" Content="Clique aqui p/ acessar a aba cadastro"
                    Grid.Row="10"
                    Height="48"
                    Background="#4CAF50"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</Window>
